@model Es.Riam.Gnoss.Web.MVC.Models.AdministrarTraducciones.TextoTraducidoModel       
@*
Descripción
-----------------------------------------------
Vista modal para la edición de un item de tipo Translate.

Variables
----------------------------------------------------------------
*@

@{
    // Url de la traducción guardada temporalmente en ViewBag
    string urlEditTranslate = ViewBag.urlEditTranslate;
    bool isInEditMode = false;
    // Título del modal por (Creación o Edición)
    string modalTitle = "";
    bool isEditingMode = false;
    CommunityModel comunidad = Html.GetComunidad();

    // Calcular la urlBase para el guardado
    string urlBase = this.Context.Request.Path.ToString().ToLower();
    if(urlBase.LastIndexOf("/editar") > 0)
    {
        isEditingMode = true;
        urlBase = urlBase.Substring(0,urlBase.LastIndexOf("/editar"));
        urlBase = string.Concat(urlBase, "/editar");
    }

    string textoTraduccionAutomatica = "";
    if (Model.Traducciones != null && Model.Traducciones.Count > 0)
    {
        textoTraduccionAutomatica = Model.Traducciones[0].Texto;
    }
}


@*
----------------------------------------------------------------
-------------------- Vista parcial para cada traducción --------------------
*@

<form action="@urlBase" method="post" id="formCreateEditTranslate">
@* Crear Nuevo o Editar traducción *@
@if (this.Context.Request.Path.ToString().ToLower().Contains("/crear"))
{    
    isEditingMode = false;
    modalTitle = "Crear traducción";       
    @*<div>TextoID:  @Html.EditorFor(m => m.TextoID) @Html.ValidationMessageFor(m => m.TextoID)</div>*@
}
else {
    isInEditMode = true;
    modalTitle = "Editar traducción " + @Model.TextoID;
    <input type="hidden" name="TextoID" value="@Model.TextoID" />
}
    <div class="modal-header">
        @* Título del Modal *@
        <p class="modal-title">
            <span class="material-icons">@( isInEditMode == true ? "edit" : "add" )</span>@modalTitle
        </p>
        @* Cierre del Modal *@
        <span class="material-icons cerrar" data-dismiss="modal" aria-label="Close">close</span>
    </div>
    <div class="modal-body">
        <div class="formulario-edicion">
            <fieldset>
                <p>@Html.GetText("DEVTOOLS","AÑADEACONTINUACIONLASTRADUCCIONESPERSONALIZADASPARALOSDIFERE")</p>
                @* ID del input a crear (Si no está en modo edición) *@
                @if (!isEditingMode)
                {
                    <div class="form-group mb-4">
                        <label class="control-label d-block">TextoID</label>                    
                        <input type="text" placeholder="@Html.GetText("DEVTOOLS","IDDELATRADUCCION")" class="form-control" 
                               id="TextoID"
                               name="TextoID">
                        <small id="TextoIDAyuda" class="form-text text-muted">@Html.GetText("DEVTOOLS","INTRODUCEUNIDENTIFICADORUNICOPARALATRADUCCIONACREAR")</small>
                    </div>
                }
                @if (comunidad.TranslatorAvailable)
                {
                    <div class="traduccion-automatica">
                        <div id="accordion" class="tabla-test">
                            <div class="card">
                                <div class="card-header">
                                    <h3 class="mb-0">
                                        <a class="btn btn-link collapsed"
                                                data-toggle="collapse"
                                                data-target="#secciontest"
                                                aria-expanded="false"
                                                aria-controls="secciontest">
                                            @Html.GetText("DEVTOOLS", "TRADUCIRTEXTO")
                                            <span class="material-icons">keyboard_arrow_down</span>
                                        </a>
                                    </h3>
                                </div>
                                <div id="secciontest"
                                     class="collapse"
                                     data-parent="#accordion">
                                    <div class="card-body">
                                        @* Texto a traducir *@
                                        <div class="form-group mb-3">
                                            <label class="control-label d-block" for="textoTraducir">@Html.GetText("DEVTOOLS", "PROBARTRADUCTOR") *</label>
                                            <input placeholder="@Html.GetText("DEVTOOLS", "INTRODUCETESTTRADUCTOR")"
                                                   type="text"
                                                   value="@textoTraduccionAutomatica"
                                                   id="textoTraducir"
                                                   name="textoTraducir"
                                                   class="form-control not-outline" />
                                        </div>

                                        @* Idioma origen *@
                                        <div class="form-group mb-3">
                                            <label class="control-label d-block" for="cmbIdiomaOrigen">@Html.GetText("DEVTOOLS", "IDIOMAORIGINALRECURSOS")</label>
                                            <select id="cmbIdiomaOrigen"
                                                    name="cmbIdiomaOrigen"
                                                    class="cmbIdiomaOrigen js-select2"
                                                    tabindex="0"
                                                    aria-hidden="false">
                                                @foreach (string code in Model.IdiomasDisponiblesTraducir.Keys)
                                                {
                                                    <option value="@code">@Model.IdiomasDisponiblesTraducir[code]</option>
                                                }
                                            </select>
                                        </div>

                                        @* Idiomas destino *@
                                        <div class="form-group mb-3">
                                            <label class="control-label d-block" for="cmbIdiomaDestino">@Html.GetText("DEVTOOLS", "IDIOMADESTINORECURSOS")</label>
                                            <select id="cmbIdiomaDestino"
                                                    name="cmbIdiomaDestino"
                                                    class="js-select2 cmbIdiomaDestino"
                                                    tabindex="0"
                                                    aria-hidden="false">
                                                <option value="">@Html.GetText("DEVTOOLS", "SELECCIONIDIOMADESTINO")</option>
                                                @{
                                                    foreach (string code in Model.IdiomasDisponiblesTraducir.Keys)
                                                    {
                                                        <option value="@code">@Model.IdiomasDisponiblesTraducir[code]</option>
                                                    }
                                                }
                                            </select>
                                            <div class="tag-list mb-3 mt-3">
                                                <!-- aqui van las tags de los roles -->
                                            </div>
                                        </div>

                                        <a class="btn btn-outline-primary uppercase" id="btnTraducir"><span>@Html.GetText("DEVTOOLS", "TRADUCIRTEXTO")</span></a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <hr />
                }
                
                @* Input para traducción en Idiomas *@
                @for (int i = 0; i < Model.Traducciones.Count; i++)
                {
                    string idioma = string.Empty;
                    string id = $"Traducciones_{i}__Texto";
                    string name = $"Traducciones[{i}].Texto";
                    string clase = $"idioma_{Model.Traducciones[i].Idioma}";
                    Model.Idiomas.TryGetValue((string)Model.Traducciones[i].Idioma, out idioma);
                        
                        <div class="form-group mb-4">
                            <label class="control-label d-block">@idioma</label>
                            @* TextArea para el contenido de la traducción *@
                            <textarea class="@clase" cols="30" rows="5" id="@id" name="@name">@Model.Traducciones[i].Texto</textarea>                            
                        </div>                        
                    <input type="hidden" class="@clase" name="Traducciones[@i].Idioma" value="@Model.Traducciones[i].Idioma" />            
                }
                @* Seccion de informe de errores del modal*@
                @Html.ValidationSummary()
                @* Botón para guardar la traduducción *@
                <div class="panelBotonera">
                    @if (Html.GetComunidad().DeshabilitarGuardarAdministracionIC)
				    {
				    	@* No permitir guardar *@
                        <input type="button" disabled title="@Html.GetComunidad().MensajeAvisoAdministracionIC" class="btn btn-primary uppercase btnNoSaveTranslate" value="@Html.GetText("COMMON","GUARDAR")" />
                    }
				    else
				    {		
				    	@* Permitir guardar *@
				    	<input type="button" class="btn btn-primary uppercase btnSaveTranslate" value="@Html.GetText("COMMON","GUARDAR")"/>								
				    }                    
                </div>
            </fieldset>
        </div>
    </div>
</form>
<script type="text/javascript">

    (function ($) {
        @* Operativa funcionamiento de Gestión de Traducciones *@
        operativaGestionTraducciones.init();
    })();
</script>

